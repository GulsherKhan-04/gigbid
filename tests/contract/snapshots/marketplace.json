 "create_proposal_draft": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "input": {
   "$defs": {
    "ProposalInput": {
     "properties": {
      "bid_amount_usd": {
       "exclusiveMinimum": 0,
       "maximum": 100000,
       "title": "Bid Amount Usd",
       "type": "number"
      },
      "connects_cost": {
       "maximum": 50,
       "minimum": 0,
       "title": "Connects Cost",
       "type": "integer"
      },
      "cover_letter": {
       "maxLength": 5000,
       "minLength": 50,
       "title": "Cover Letter",
       "type": "string"
      },
      "dry_run": {
       "default": false,
       "title": "Dry Run",
       "type": "boolean"
      },
      "idempotency_key": {
       "maxLength": 128,
       "minLength": 8,
       "title": "Idempotency Key",
       "type": "string"
      },
      "job_id": {
       "maxLength": 64,
       "minLength": 1,
       "title": "Job Id",
       "type": "string"
      },
      "rate_type": {
       "default": "fixed",
       "pattern": "^(fixed|hourly)$",
       "title": "Rate Type",
       "type": "string"
      },
      "screening_answers": {
       "items": {
        "type": "string"
       },
       "maxItems": 10,
       "title": "Screening Answers",
       "type": "array"
      },
      "trace_id": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Trace Id"
      },
      "user": {
       "maxLength": 64,
       "minLength": 1,
       "title": "User",
       "type": "string"
      }
     },
     "required": [
      "user",
      "job_id",
      "cover_letter",
      "bid_amount_usd",
      "connects_cost",
      "idempotency_key"
     ],
     "title": "ProposalInput",
     "type": "object"
    }
   },
   "properties": {
    "p": {
     "$ref": "#/$defs/ProposalInput"
    }
   },
   "required": [
    "p"
   ],
   "title": "create_proposal_draftArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "dry_run": {
     "title": "Dry Run",
     "type": "boolean"
    },
    "preview": {
     "additionalProperties": true,
     "title": "Preview",
     "type": "object"
    },
    "replayed": {
     "default": false,
     "title": "Replayed",
     "type": "boolean"
    },
    "result": {
     "additionalProperties": true,
     "title": "Result",
     "type": "object"
    }
   },
   "required": [
    "dry_run"
   ],
   "title": "WriteResult",
   "type": "object"
  }
 },
