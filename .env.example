# Copy to .env (or run `python scripts/setup_env.py`, which also generates the secrets). Never commit .env.
APP_ENV=development
APP_SECRET_KEY=                 # generated by scripts/setup_env.py
TOKEN_ENCRYPTION_KEY=           # generated by scripts/setup_env.py (encrypts Upwork OAuth tokens)
DATABASE_URL=                   # empty = local SQLite file; docker compose sets Postgres automatically
REDIS_URL=                      # empty = run agents inside the API process; docker compose sets Redis
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
WEB_URL=http://localhost:5173

# --- Models (open profile is required). Groq, OpenRouter and Together all work with these two lines. ---
MODEL_PROFILE=open
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=                    # PASTE YOUR KEY: free at https://console.groq.com/keys
OLLAMA_URL=http://localhost:11434
OLLAMA_OPENAI_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
PAID_LLM_BASE_URL=
PAID_LLM_API_KEY=               # optional, only for the `paid` profile
EMBEDDINGS_PROVIDER=            # empty = Ollama nomic-embed-text; "hash" only for offline tests
RAG_VARIANT=                    # empty = value in agent/config.yaml

# --- Marketplace ---
MARKETPLACE_MODE=gigsim         # gigsim | upwork_live
MARKETPLACE_BACKEND=gigsim    # gigsim = GigSim-lite stand-in (or the real GigSim when you get it); fixtures = tiny sample
START_SIMULATOR=1               # 1 = the API starts GigSim-lite on :8081 for you; 0 when using the real GigSim
SIM_POLICY=v2                   # GigSim-lite rules version; v2 = simulated 2 Nov policy update
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=               # PASTE from the GigSim docs/starter kit, if it needs one
MCP_TRANSPORT=stdio             # stdio locally; docker compose sets http
PORTFOLIO_MCP_TOKEN=            # generated
MARKETPLACE_MCP_TOKEN=          # generated
WORKSPACE_MCP_TOKEN=            # generated

# --- Upwork live mode (optional) ---
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_CLIENT_ID=               # PASTE from your Upwork developer app
UPWORK_CLIENT_SECRET=           # PASTE from your Upwork developer app
UPWORK_OAUTH_AUTHORIZE_URL=     # PASTE from Upwork MCP docs (upwork.com/ai/mcp)
UPWORK_OAUTH_TOKEN_URL=         # PASTE from Upwork MCP docs
UPWORK_REDIRECT_URI=http://localhost:8000/api/oauth/upwork/callback

# --- GitHub MCP (repo ingestion) ---
GITHUB_TOKEN=                   # PASTE a read-only token: github.com/settings/tokens
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# --- Tracing (LangSmith; LangGraph traces every node automatically when these are set) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=              # PASTE YOUR KEY: free at https://smith.langchain.com
LANGSMITH_PROJECT=gigbid
VITE_TRACE_URL=                 # optional: your LangSmith project URL, shown as "Open full trace"

# --- Reviewer login for graders (put these in the Classroom private comment, not the repo) ---
REVIEWER_EMAIL=reviewer@gigbid.dev
REVIEWER_PASSWORD=              # generated
REVIEWER_PERSONA=
